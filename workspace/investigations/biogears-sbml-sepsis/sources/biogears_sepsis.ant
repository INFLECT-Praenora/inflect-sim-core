  q_LKidneyE = C_LKidneyE*42.3537; Alb_LKidney = 0.02*42.315
  q_RKidneyE = C_RKidneyE*42.3537; Alb_RKidney = 0.02*42.315
  q_LiverE = C_LiverE*1.70461; Alb_Liver = 0.02*289.8
  q_LLungE = C_LLungE*-13.7813; Alb_LLung = 0.02*84
  q_RLungE = C_RLungE*-13.7813; Alb_RLung = 0.02*84
  q_MuscleE = C_MuscleE*9.31807; Alb_Muscle = 0.02*3422
  q_MyocardE = C_MyocardE*9.31826; Alb_Myocard = 0.02*105.6
  q_SkinE = C_SkinE*-14.0179; Alb_Skin = 0.02*1260.6
  q_SpleenE = C_SpleenE*9.32682; Alb_Spleen = 0.02*31.05
  q_Lymph = C_Lymph*5; Alb_lymph = 0.02*(q_Lymph + 1600)
  Alb_v = 0.045*BV
  tc = 0; Tcyc = 60/HR0; EmaxL = EmaxL0; EmaxR = EmaxR0
  SBP = SBP0; DBP = DBP0; MAP = 87; CVP = 3.8; SV = 81; HR = HR0
  PmaxAo = SBP0; PminAo = SBP0; PintAo = 0; PintVC = 0; beatSV = 0
  epsC = 0.04226; epsA = 0.04226; xCP = 2.5
  mHRs = -0.233; mHRv = 0.582; mE = 0.206; mRe = 1.02; mRm = 1.02; mRs = 0.24; mC = -0.1; fatigue = 0
  PT = 0; MT = 10; NT = 0; B = 1; PB = 0; TR = 0; MR = 1; MA = 0; NR = 1; NA = 0
  iNOS = 0; iNOSd = 0; eNOS = 0.05; NO3 = 0; TNF = 0; I6 = 0.001; I10 = 0.01; I12 = 0; CA = 0; TI = 1

  // ------------------------------------------------------------------
  // Stabilised healthy state (closed-loop run to steady state, as the
  // BioGears stabilisation does); these values override those above
  // ------------------------------------------------------------------
  sR = 0.8803103459; sCao = 1.166785426; sCvc = 1.019216356; fSP0 = 4.059328428; fSSA0 = 4.432416414; fVag0 = 5.990631952; Pop = 114.0642119; xCP0 = 7.712953637
