// =====================================================================
// BioGears sepsis core in Antimony
//
// Translated from the BioGears physiology engine (Apache License 2.0,
// github.com/BioGearsEngine/core): cardiovascular circuit, tissue fluid
// exchange with albumin transport, baroreflex, and the Acute Inflammatory
// Response model (McDaniel et al. 2019, Front Physiol 10:1321).
// Patient: BioGears StandardMale (77.1 kg, HR 72, BP 114/73.5).
//
// Units: time s, pressure mmHg, volume mL, flow mL/s, albumin g.
// Inflammation equations are written per hour in BioGears; here each
// derivative is divided by 3600 and multiplied by infScale (default 1).
//
// Circuit conventions (as in the BioGears circuit solver):
//  - each compliant node carries charge q = C*P, so P = q/C; when the
//    baroreflex rescales C, q is conserved and P moves (venous pooling)
//  - node blood volume = q + U, with U the unstressed volume fixed at setup
//  - valves are ideal diodes in series with the path resistance
//
// Differences from BioGears:
//  - CV-only circuit: no detailed renal (no urine) or cerebral circuits;
//    kidneys and brain are the simple windkessels BioGears uses when those
//    modules are off
//  - SI, LI and splanchnic merged into one gut node (BioGears ties them
//    with zero-resistance pressure sources); pulmonary veins merged with
//    the left atrium (joined by 2e-6 mmHg s/mL in BioGears)
//  - no intracellular water shift, respiration, gas exchange, energy,
//    temperature or lactate; chemoreceptor and lung-stretch afferents fixed
//  - single well-mixed plasma albumin pool
//  - stabilisation tuned with BioGears' TuneCircuit scale factors here, so
//    resistances and compliances differ slightly from a BioGears run
//  - baroreceptor set-point adaptation omitted (BioGears disables it
//    during infection); NO has no direct haemodynamic effect (as in the
//    current BioGears code)
//  - BioGears' tissue-pathogen equation is kept as coded, with (1 - PT)
//    where (1 - PT/uP) was probably intended
// Start an infection with severity = 1, 2 or 3 and infectionStart > 0.
// =====================================================================

function hillA(x, n, h)
  x^h/(x^h + n^h)
end

function hillI(x, n, h)
  1/(1 + (x/n)^h)
end

model biogears_sepsis

  // ------------------------------------------------------------------
  // Patient and setup targets (BioGears SetupPatient, SetupCardiovascular)
  // ------------------------------------------------------------------
  BV = 5517.73               // baseline blood volume, 65.6*weight^1.02
  SBP0 = 114.0; DBP0 = 73.5; HR0 = 72.0
  CO0 = 97.2             // target cardiac output (81 mL x 72/min)
  HRmax = 177.2; HRmin = 0.001
  srm = 0.849                  // systemicResistanceModifier
  lacm = 0.4333                // largeArteriesComplianceModifier
  // stabilisation scales (BioGears TuneCircuit equivalents; set by tuning here)
  sR = 1; sC = 1; sRao = 1; sCao = 1; sRrh = 1; sCvc = 1

  // ------------------------------------------------------------------
  // Vascular resistances (mmHg s/mL), computed from target pressures and
  // flows exactly as in SetupCardiovascular
  // ------------------------------------------------------------------
  P_VC0 = 3.7962; P_LV0 = 121.6; P_RH0 = 19.0004
  R_ao := sRao*(P_LV0 - SBP0)/CO0
  R_rh := sRrh*(4.8165 - P_VC0)/CO0   // vena cava to right atrium
  R_ra = 5.94e-5; R_la = 8.9e-5   // atrium to ventricle (through valve)
  R_Brain_a0 := sR*srm*0.94*(SBP0 - 9.12)/11.664
  R_Brain_v0 := sR*srm*(9.12 - P_VC0)/11.664
  R_Bone_a0 := sR*srm*1.0*(SBP0 - 37.62)/4.86
  R_Bone_v0 := sR*srm*(37.62 - P_VC0)/4.86
  R_Fat_a0 := sR*srm*1.0*(SBP0 - 37.62)/4.86
  R_Fat_v0 := sR*srm*(37.62 - P_VC0)/4.86
  R_LArm_a0 := sR*srm*1.0*(SBP0 - 37.62)/0.703728
  R_LArm_v0 := sR*srm*(37.62 - P_VC0)/0.703728
  R_RArm_a0 := sR*srm*1.0*(SBP0 - 37.62)/0.703728
  R_RArm_v0 := sR*srm*(37.62 - P_VC0)/0.703728
  R_LKidney_a0 := sR*srm*1.0*(SBP0 - 37.62)/4.7628
  R_LKidney_v0 := sR*(37.62 - P_VC0)/4.7628
  R_RKidney_a0 := sR*srm*1.0*(SBP0 - 37.62)/4.7628
  R_RKidney_v0 := sR*(37.62 - P_VC0)/4.7628
  R_LLeg_a0 := sR*srm*1.0*(SBP0 - 37.62)/1.05559
  R_LLeg_v0 := sR*srm*(37.62 - P_VC0)/1.05559
  R_RLeg_a0 := sR*srm*1.0*(SBP0 - 37.62)/1.05559
  R_RLeg_v0 := sR*srm*(37.62 - P_VC0)/1.05559
  R_Muscle_a0 := sR*srm*1.0*(SBP0 - 37.62)/16.524
  R_Muscle_v0 := sR*srm*(37.62 - P_VC0)/16.524
  R_Myocard_a0 := sR*srm*1.0*(SBP0 - 37.62)/3.888
  R_Myocard_v0 := sR*srm*(37.62 - P_VC0)/3.888
  R_Skin_a0 := sR*srm*1.0*(SBP0 - 9.4962)/6.5124
  R_Skin_v0 := sR*srm*(9.4962 - P_VC0)/6.5124
  R_Spleen_a0 := sR*srm*1.0*(SBP0 - 37.62)/2.916
  R_Spleen_v0 := sR*srm*(37.62 - 28.5)/2.916
  R_Gut_a0 := sR*srm/(9.72/(SBP0 - 37.62) + 3.888/(SBP0 - 37.62) + 2.50776/(SBP0 - 37.62))   // SI, LI, splanchnic in parallel
  R_Gut_v0 := sR*srm/(9.72/(37.62 - 28.5) + 3.888/(37.62 - 28.5) + 2.50776/(37.62 - 28.5))
  R_Liver_a0 := sR*srm*(SBP0 - 28.5)/7.29
  R_Liver_v0 := sR*srm*(28.5 - P_VC0)/26.3218
  R_PV := sR*srm*0.001       // portal vein path
  R_RPA = (19.0004 - 15.1996)/45.7545   // BioGears uses the left-lung value for both sides
  R_RPCap = (15.1996 - 7.41)/50.5707
  R_RPVein = (7.41 - 4.38444)/50.5707
  R_RShunt = (15.1996 - 7.41)/0.8748
  R_LPA = (19.0004 - 15.1996)/45.7545   // BioGears uses the left-lung value for both sides
  R_LPCap = (15.1996 - 7.41)/45.7545
  R_LPVein = (7.41 - 4.38444)/45.7545
  R_LShunt = (15.1996 - 7.41)/0.8748

  // ------------------------------------------------------------------
  // Compliances (mL/mmHg) = baseline volume / target pressure; volume
  // modifiers then raise baseline volumes, giving unstressed volumes U
  // ------------------------------------------------------------------
  C_LA = 44.9278 + 40.6489 + 1.77356   // pulmonary veins + left atrium
  U_LA = 255.525 - C_LA*4.9
  C_Ao0 := sCao*lacm*275.887/114
  U_Ao = 1.1891*275.887 - C_Ao0*114
  C_Brain0 := sC*66.2128/9.12
  U_Brain = 1.03634*66.2128 - C_Brain0*9.12
  C_Bone0 := sC*386.241/37.62
  U_Bone = 1.15868*386.241 - C_Bone0*37.62
  C_Fat0 := sC*275.887/37.62
  U_Fat = 1.15973*275.887 - C_Fat0*37.62
  C_LArm0 := sC*55.1773/37.62
  U_LArm = 1.15974*55.1773 - C_LArm0*37.62
  C_RArm0 := sC*55.1773/37.62
  U_RArm = 1.15974*55.1773 - C_RArm0*37.62
  C_LKidney0 := sC*52.4185/37.62
  U_LKidney = 0.703967*52.4185 - C_LKidney0*37.62
  C_RKidney0 := sC*52.4185/37.62
  U_RKidney = 0.703967*52.4185 - C_RKidney0*37.62
  C_LLeg0 := sC*83.3178/37.62
  U_LLeg = 1.15974*83.3178 - C_LLeg0*37.62
  C_RLeg0 := sC*83.3178/37.62
  U_RLeg = 1.15974*83.3178 - C_RLeg0*37.62
  C_Muscle0 := sC*772.483/37.62
  U_Muscle = 1.15974*772.483 - C_Muscle0*37.62
  C_Myocard0 := sC*38.6241/37.62
  U_Myocard = 1.15973*38.6241 - C_Myocard0*37.62
  C_Skin0 := sC*176.568/9.4962
  U_Skin = 1.04326*176.568 - C_Skin0*9.4962
  C_Spleen0 := sC*77.2483/37.62
  U_Spleen = 1.15942*77.2483 - C_Spleen0*37.62
  C_Gut0 := sC*378.517/37.62
  U_Gut = 1.15913*378.517 - C_Gut0*37.62
  C_Liver0 := sC*584.88/28.5
  U_Liver = 1.14804*584.88 - C_Liver0*28.5
  C_VC0 := sCvc*1362.88/3.7962
  U_VC = 0.759308*1362.88 - C_VC0*3.7962
  C_RA0 := 1*8.69043/2.9
  U_RA = 1*8.69043 - C_RA0*2.9
  C_RPA0 := 1*98.4916/15.1996
  U_RPA = 0.896934*98.4916 - C_RPA0*15.1996
  C_RPC0 := 1*66.6266/7.41
  U_RPC = 0.782749*66.6266 - C_RPC0*7.41
  C_LPA0 := 1*89.1114/15.1996
  U_LPA = 0.986127*89.1114 - C_LPA0*15.1996
  C_LPC0 := 1*60.2812/7.41
  U_LPC = 0.841728*60.2812 - C_LPC0*7.41
  EmaxL0 = 2.49; EminL = 0.049; EmaxR0 = 1.08; EminR = 0.0243
  U_LV = 10.6216; U_RV = 10.6216

  // live compliances: baroreflex scales systemic organ compliances
  C_Ao := C_Ao0
  C_Brain := C_Brain0
  C_Bone := C_Bone0*cScale
  C_Fat := C_Fat0*cScale
  C_LArm := C_LArm0*cScale
  C_RArm := C_RArm0*cScale
  C_LKidney := C_LKidney0*cScale
  C_RKidney := C_RKidney0*cScale
  C_LLeg := C_LLeg0*cScale
  C_RLeg := C_RLeg0*cScale
  C_Muscle := C_Muscle0*cScale
  C_Myocard := C_Myocard0*cScale
  C_Skin := C_Skin0*cScale
  C_Spleen := C_Spleen0*cScale
  C_Gut := C_Gut0*cScale
  C_Liver := C_Liver0*cScale
  C_VC := C_VC0
  C_RA := C_RA0
  C_RPA := C_RPA0
  C_RPC := C_RPC0
  C_LPA := C_LPA0
  C_LPC := C_LPC0

  // pressures
  P_Ao := q_Ao/C_Ao
  P_Brain := q_Brain/C_Brain
  P_Bone := q_Bone/C_Bone
  P_Fat := q_Fat/C_Fat
  P_LArm := q_LArm/C_LArm
  P_RArm := q_RArm/C_RArm
  P_LKidney := q_LKidney/C_LKidney
  P_RKidney := q_RKidney/C_RKidney
  P_LLeg := q_LLeg/C_LLeg
  P_RLeg := q_RLeg/C_RLeg
  P_Muscle := q_Muscle/C_Muscle
  P_Myocard := q_Myocard/C_Myocard
  P_Skin := q_Skin/C_Skin
  P_Spleen := q_Spleen/C_Spleen
  P_Gut := q_Gut/C_Gut
  P_Liver := q_Liver/C_Liver
  P_VC := q_VC/C_VC
  P_RA := q_RA/C_RA
  P_RPA := q_RPA/C_RPA
  P_RPC := q_RPC/C_RPC
  P_LPA := q_LPA/C_LPA
  P_LPC := q_LPC/C_LPC
  P_LA := q_LA/C_LA
  P_LV := EL*q_LV
  P_RV := ER*q_RV

  // ------------------------------------------------------------------
  // Heart driver: double-Hill elastance (Stergiopulos 1996), period and
  // Emax fixed at the start of each beat as in BeginCardiacCycle
  // ------------------------------------------------------------------
  tc' = 1
  tn := tc/Tcyc
  eshape := ((tn/0.303)^1.32/(1 + (tn/0.303)^1.32))*(1/(1 + (tn/0.508)^21.9))/0.598
  EL := (EmaxL - EminL)*eshape + EminL
  ER := (EmaxR - EminR)*eshape + EminR
  HRdrive := max(HRmin, min(HRmax, HR0*hrScale))
  E_beat: at (tc >= Tcyc): tc = 0, Tcyc = 60/HRdrive, EmaxL = EmaxL0*eScale, EmaxR = EmaxR0*eScale, SBP = PmaxAo, DBP = PminAo, MAP = PintAo/Tcyc, CVP = PintVC/Tcyc, SV = beatSV, HR = 60/Tcyc, PmaxAo = P_Ao, PminAo = P_Ao, PintAo = 0, PintVC = 0, beatSV = 0
  // per-beat measurements
  PmaxAo' = 200*max(0, P_Ao - PmaxAo)
  PminAo' = -200*max(0, PminAo - P_Ao)
  PintAo' = P_Ao
  PintVC' = P_VC
  beatSV' = Q_aov
  COmeas := SV*HR/1000          // L/min

  // ------------------------------------------------------------------
  // Flows (mL/s)
  // ------------------------------------------------------------------
  Q_aov := max(0, P_LV - P_Ao)/R_ao           // aortic valve
  Q_mit := max(0, P_LA - P_LV)/R_la           // mitral valve
  Q_tri := max(0, P_RA - P_RV)/R_ra           // tricuspid valve
  Q_rh  := (P_VC - P_RA)/R_rh
  pulOpen := piecewise(1, P_RV > (P_RPA + P_LPA)/2, 0)   // pulmonic valve
  Q_RPA := pulOpen*(P_RV - P_RPA)/R_RPA
  Q_LPA := pulOpen*(P_RV - P_LPA)/R_LPA
  Q_RPCap := (P_RPA - P_RPC)/R_RPCap
  Q_RShunt := (P_RPA - P_LA)/R_RShunt
  Q_RPVein := (P_RPC - P_LA)/R_RPVein
  Q_LPCap := (P_LPA - P_LPC)/R_LPCap
  Q_LShunt := (P_LPA - P_LA)/R_LShunt
  Q_LPVein := (P_LPC - P_LA)/R_LPVein
  R_Brain_a := R_Brain_a0
  R_Brain_v := R_Brain_v0
  R_Bone_a := max(0.1, R_Bone_a0*rsExt)
  R_Bone_v := max(0.1, R_Bone_v0*rsExt)
  R_Fat_a := max(0.1, R_Fat_a0*rsExt)
  R_Fat_v := max(0.1, R_Fat_v0*rsExt)
  R_LArm_a := max(0.1, R_LArm_a0*rsExt)
  R_LArm_v := max(0.1, R_LArm_v0*rsExt)
  R_RArm_a := max(0.1, R_RArm_a0*rsExt)
  R_RArm_v := max(0.1, R_RArm_v0*rsExt)
  R_LKidney_a := max(0.1, R_LKidney_a0*rsExt)
  R_LKidney_v := max(0.1, R_LKidney_v0*rsExt)
  R_RKidney_a := max(0.1, R_RKidney_a0*rsExt)
  R_RKidney_v := max(0.1, R_RKidney_v0*rsExt)
  R_LLeg_a := max(0.1, R_LLeg_a0*rsExt)
  R_LLeg_v := max(0.1, R_LLeg_v0*rsExt)
  R_RLeg_a := max(0.1, R_RLeg_a0*rsExt)
  R_RLeg_v := max(0.1, R_RLeg_v0*rsExt)
  R_Muscle_a := max(0.1, R_Muscle_a0*rsMus)
  R_Muscle_v := max(0.1, R_Muscle_v0*rsMus)
  R_Myocard_a := R_Myocard_a0
  R_Myocard_v := R_Myocard_v0
  R_Skin_a := max(0.1, R_Skin_a0*rsExt)
  R_Skin_v := max(0.1, R_Skin_v0*rsExt)
  R_Spleen_a := max(0.1, R_Spleen_a0*rsSpl)
  R_Spleen_v := max(0.1, R_Spleen_v0*rsSpl)
  R_Gut_a := max(0.1, R_Gut_a0*rsSpl)
  R_Gut_v := max(0.1, R_Gut_v0*rsSpl)
  R_Liver_a := max(0.1, R_Liver_a0*rsSpl)
  R_Liver_v := max(0.1, R_Liver_v0*rsSpl)
  R_PVs := R_PV*rsSpl
  // portal vein: no compliance, pressure from Kirchhoff's current law
  P_portal := (P_Gut/R_Gut_v + P_Spleen/R_Spleen_v + P_Liver/R_PVs)/(1/R_Gut_v + 1/R_Spleen_v + 1/R_PVs)
  Qa_Brain := (P_Ao - P_Brain)/R_Brain_a
  Qa_Bone := (P_Ao - P_Bone)/R_Bone_a
  Qa_Fat := (P_Ao - P_Fat)/R_Fat_a
  Qa_LArm := (P_Ao - P_LArm)/R_LArm_a
  Qa_RArm := (P_Ao - P_RArm)/R_RArm_a
  Qa_LKidney := (P_Ao - P_LKidney)/R_LKidney_a
  Qa_RKidney := (P_Ao - P_RKidney)/R_RKidney_a
  Qa_LLeg := (P_Ao - P_LLeg)/R_LLeg_a
  Qa_RLeg := (P_Ao - P_RLeg)/R_RLeg_a
  Qa_Muscle := (P_Ao - P_Muscle)/R_Muscle_a
  Qa_Myocard := (P_Ao - P_Myocard)/R_Myocard_a
  Qa_Skin := (P_Ao - P_Skin)/R_Skin_a
  Qa_Spleen := (P_Ao - P_Spleen)/R_Spleen_a
  Qa_Gut := (P_Ao - P_Gut)/R_Gut_a
  Qa_Liver := (P_Ao - P_Liver)/R_Liver_a
  Qv_Brain := (P_Brain - P_VC)/R_Brain_v
  Qv_Bone := (P_Bone - P_VC)/R_Bone_v
  Qv_Fat := (P_Fat - P_VC)/R_Fat_v
  Qv_LArm := (P_LArm - P_VC)/R_LArm_v
  Qv_RArm := (P_RArm - P_VC)/R_RArm_v
  Qv_LKidney := (P_LKidney - P_VC)/R_LKidney_v
  Qv_RKidney := (P_RKidney - P_VC)/R_RKidney_v
  Qv_LLeg := (P_LLeg - P_VC)/R_LLeg_v
  Qv_RLeg := (P_RLeg - P_VC)/R_RLeg_v
  Qv_Muscle := (P_Muscle - P_VC)/R_Muscle_v
  Qv_Myocard := (P_Myocard - P_VC)/R_Myocard_v
  Qv_Skin := (P_Skin - P_VC)/R_Skin_v
  Qv_Spleen := (P_Spleen - P_portal)/R_Spleen_v
  Qv_Gut := (P_Gut - P_portal)/R_Gut_v
  Qv_Liver := (P_Liver - P_VC)/R_Liver_v
  Q_portal := (P_portal - P_Liver)/R_PVs

  // ------------------------------------------------------------------
  // Tissue fluid exchange (SetupTissue): V -[-COPv]- E1 -[Rcap*TI]- E2
  // -[+COPe]- E3(compliance), E3 -[lymph drive]- L1 -[Rlymph]- valve -> Lymph
  // Intracellular water exchange is not modelled (held fixed).
  // ------------------------------------------------------------------
  copV0 = 26.7736; copE0 = 8.65331
  // COP (Landis-Pappenheimer) = 2.1*TP + 0.16*TP^2 + 0.009*TP^3, TP = 1.6*albumin (g/dL)
  TPv := 1.6*100*Alb_v/Vblood
  copV := 2.1*TPv + 0.16*TPv^2 + 0.009*TPv^3
  sigAlb := min(1, max(0, 0.954*TIeff))   // albumin reflection coefficient
  Dalb = 0.03306/60          // albumin diffusivity, mL/s/kg
  P_Lymph := q_Lymph/C_Lymph
  C_Lymph = 400
  R_LymphVC = 60*(5 - P_VC0)/3.5
  Q_LymphVC := (P_Lymph - P_VC)/R_LymphVC
  // Fat
  C_FatE = 2376.18/32.4385; Rcap_Fat = 327.107; Rly_Fat = 282.498; drive_Fat = 0; m_Fat = 16.1932
  P_FatE := q_FatE/C_FatE
  V_FatE := q_FatE + 1693.61
  TPe_Fat := 1.6*100*Alb_Fat/V_FatE
  copE_Fat := 2.1*TPe_Fat + 0.16*TPe_Fat^2 + 0.009*TPe_Fat^3
  Qf_Fat := (P_Fat - copV - (P_FatE - copE_Fat))/(Rcap_Fat*TIeff)
  Ql_Fat := max(0, P_FatE + drive_Fat - P_Lymph)/Rly_Fat
  Pe_Fat := max(1e-9, Qf_Fat*(1 - sigAlb)/(Dalb*m_Fat))
  Ja_Fat := max(0, Qf_Fat*(1 - sigAlb)*(Alb_v/Vblood - Alb_Fat/V_FatE*exp(-Pe_Fat))/(1 - exp(-Pe_Fat)))
  q_FatE' = Qf_Fat - Ql_Fat
  Alb_Fat' = Ja_Fat - Ql_Fat*Alb_Fat/V_FatE
  // Bone
  C_BoneE = 807.692/32.468; Rcap_Bone = 962.328; Rly_Bone = 836.777; drive_Bone = 0; m_Bone = 10.5
  P_BoneE := q_BoneE/C_BoneE
  V_BoneE := q_BoneE + 575.154
  TPe_Bone := 1.6*100*Alb_Bone/V_BoneE
  copE_Bone := 2.1*TPe_Bone + 0.16*TPe_Bone^2 + 0.009*TPe_Bone^3
  Qf_Bone := (P_Bone - copV - (P_BoneE - copE_Bone))/(Rcap_Bone*TIeff)
  Ql_Bone := max(0, P_BoneE + drive_Bone - P_Lymph)/Rly_Bone
  Pe_Bone := max(1e-9, Qf_Bone*(1 - sigAlb)/(Dalb*m_Bone))
  Ja_Bone := max(0, Qf_Bone*(1 - sigAlb)*(Alb_v/Vblood - Alb_Bone/V_BoneE*exp(-Pe_Bone))/(1 - exp(-Pe_Bone)))
  q_BoneE' = Qf_Bone - Ql_Bone
  Alb_Bone' = Ja_Bone - Ql_Bone*Alb_Bone/V_BoneE
  // Brain
  C_BrainE = 234.9/9.12; Rcap_Brain = 3308.92; Rly_Brain = 661.784; drive_Brain = 20.0003; m_Brain = 1.45
  P_BrainE := q_BrainE/C_BrainE
  V_BrainE := q_BrainE + 595.5
  TPe_Brain := 1.6*100*Alb_Brain/V_BrainE
  copV_Brain = copV0; copE_Brain = copE0     // brain COPs are not updated in BioGears
  Qf_Brain := (P_Brain - copV_Brain - (P_BrainE - copE_Brain))/Rcap_Brain
  Ql_Brain := max(0, P_BrainE + drive_Brain - P_Lymph)/Rly_Brain
  Ja_Brain := 0
  q_BrainE' = Qf_Brain - Ql_Brain
  Alb_Brain' = Ja_Brain - Ql_Brain*Alb_Brain/V_BrainE
  // Gut
  C_GutE = 287.64/32.4768; Rcap_Gut = 2702.22; Rly_Gut = 2354.41; drive_Gut = 0; m_Gut = 1.02
  P_GutE := q_GutE/C_GutE
  V_GutE := q_GutE + 204.772
  TPe_Gut := 1.6*100*Alb_Gut/V_GutE
  copE_Gut := 2.1*TPe_Gut + 0.16*TPe_Gut^2 + 0.009*TPe_Gut^3
  Qf_Gut := (P_Gut - copV - (P_GutE - copE_Gut))/(Rcap_Gut*TIeff)
  Ql_Gut := max(0, P_GutE + drive_Gut - P_Lymph)/Rly_Gut
  Pe_Gut := max(1e-9, Qf_Gut*(1 - sigAlb)/(Dalb*m_Gut))
  Ja_Gut := max(0, Qf_Gut*(1 - sigAlb)*(Alb_v/Vblood - Alb_Gut/V_GutE*exp(-Pe_Gut))/(1 - exp(-Pe_Gut)))
  q_GutE' = Qf_Gut - Ql_Gut
  Alb_Gut' = Ja_Gut - Ql_Gut*Alb_Gut/V_GutE
  // LKidney
  C_LKidneyE = 42.315/65.474; Rcap_LKidney = 18368.6; Rly_LKidney = 137227; drive_LKidney = 0; m_LKidney = 0.155
  P_LKidneyE := q_LKidneyE/C_LKidneyE
  V_LKidneyE := q_LKidneyE + 14.9424
  TPe_LKidney := 1.6*100*Alb_LKidney/V_LKidneyE
  copE_LKidney := 2.1*TPe_LKidney + 0.16*TPe_LKidney^2 + 0.009*TPe_LKidney^3
  Qf_LKidney := (P_LKidney - copV - (P_LKidneyE - copE_LKidney))/(Rcap_LKidney*TIeff)
  Ql_LKidney := max(0, P_LKidneyE + drive_LKidney - P_Lymph)/Rly_LKidney
  Pe_LKidney := max(1e-9, Qf_LKidney*(1 - sigAlb)/(Dalb*m_LKidney))
  Ja_LKidney := max(0, Qf_LKidney*(1 - sigAlb)*(Alb_v/Vblood - Alb_LKidney/V_LKidneyE*exp(-Pe_LKidney))/(1 - exp(-Pe_LKidney)))
  q_LKidneyE' = Qf_LKidney - Ql_LKidney
  Alb_LKidney' = Ja_LKidney - Ql_LKidney*Alb_LKidney/V_LKidneyE
  // RKidney
  C_RKidneyE = 42.315/65.474; Rcap_RKidney = 18368.6; Rly_RKidney = 137227; drive_RKidney = 0; m_RKidney = 0.155
  P_RKidneyE := q_RKidneyE/C_RKidneyE
  V_RKidneyE := q_RKidneyE + 14.9424
  TPe_RKidney := 1.6*100*Alb_RKidney/V_RKidneyE
  copE_RKidney := 2.1*TPe_RKidney + 0.16*TPe_RKidney^2 + 0.009*TPe_RKidney^3
  Qf_RKidney := (P_RKidney - copV - (P_RKidneyE - copE_RKidney))/(Rcap_RKidney*TIeff)
  Ql_RKidney := max(0, P_RKidneyE + drive_RKidney - P_Lymph)/Rly_RKidney
  Pe_RKidney := max(1e-9, Qf_RKidney*(1 - sigAlb)/(Dalb*m_RKidney))
  Ja_RKidney := max(0, Qf_RKidney*(1 - sigAlb)*(Alb_v/Vblood - Alb_RKidney/V_RKidneyE*exp(-Pe_RKidney))/(1 - exp(-Pe_RKidney)))
  q_RKidneyE' = Qf_RKidney - Ql_RKidney
  Alb_RKidney' = Ja_RKidney - Ql_RKidney*Alb_RKidney/V_RKidneyE
  // Liver
  C_LiverE = 289.8/24.8249; Rcap_Liver = 2682.07; Rly_Liver = 536.415; drive_Liver = 4.29539; m_Liver = 1.8
  P_LiverE := q_LiverE/C_LiverE
  V_LiverE := q_LiverE + 269.901
  TPe_Liver := 1.6*100*Alb_Liver/V_LiverE
  copE_Liver := 2.1*TPe_Liver + 0.16*TPe_Liver^2 + 0.009*TPe_Liver^3
  Qf_Liver := (P_Liver - copV - (P_LiverE - copE_Liver))/(Rcap_Liver*TIeff)
  Ql_Liver := max(0, P_LiverE + drive_Liver - P_Lymph)/Rly_Liver
  Pe_Liver := max(1e-9, Qf_Liver*(1 - sigAlb)/(Dalb*m_Liver))
  Ja_Liver := max(0, Qf_Liver*(1 - sigAlb)*(Alb_v/Vblood - Alb_Liver/V_LiverE*exp(-Pe_Liver))/(1 - exp(-Pe_Liver)))
  q_LiverE' = Qf_Liver - Ql_Liver
  Alb_Liver' = Ja_Liver - Ql_Liver*Alb_Liver/V_LiverE
  // LLung
  C_LLungE = 84/9.339; Rcap_LLung = 9253.16; Rly_LLung = 1850.63; drive_LLung = 19.7813; m_LLung = 0.25
  P_LLungE := q_LLungE/C_LLungE
  V_LLungE := q_LLungE + 207.957
  TPe_LLung := 1.6*100*Alb_LLung/V_LLungE
  copE_LLung := 2.1*TPe_LLung + 0.16*TPe_LLung^2 + 0.009*TPe_LLung^3
  Qf_LLung := (P_LPC - copV - (P_LLungE - copE_LLung))/(Rcap_LLung*TIeff)
  Ql_LLung := max(0, P_LLungE + drive_LLung - P_Lymph)/Rly_LLung
  Pe_LLung := max(1e-9, Qf_LLung*(1 - sigAlb)/(Dalb*m_LLung))
  Ja_LLung := max(0, Qf_LLung*(1 - sigAlb)*(Alb_v/Vblood - Alb_LLung/V_LLungE*exp(-Pe_LLung))/(1 - exp(-Pe_LLung)))
  q_LLungE' = Qf_LLung - Ql_LLung
  Alb_LLung' = Ja_LLung - Ql_LLung*Alb_LLung/V_LLungE
  // RLung
  C_RLungE = 84/9.339; Rcap_RLung = 9253.16; Rly_RLung = 1850.63; drive_RLung = 19.7813; m_RLung = 0.25
  P_RLungE := q_RLungE/C_RLungE
  V_RLungE := q_RLungE + 207.957
  TPe_RLung := 1.6*100*Alb_RLung/V_RLungE
  copE_RLung := 2.1*TPe_RLung + 0.16*TPe_RLung^2 + 0.009*TPe_RLung^3
  Qf_RLung := (P_RPC - copV - (P_RLungE - copE_RLung))/(Rcap_RLung*TIeff)
  Ql_RLung := max(0, P_RLungE + drive_RLung - P_Lymph)/Rly_RLung
  Pe_RLung := max(1e-9, Qf_RLung*(1 - sigAlb)/(Dalb*m_RLung))
  Ja_RLung := max(0, Qf_RLung*(1 - sigAlb)*(Alb_v/Vblood - Alb_RLung/V_RLungE*exp(-Pe_RLung))/(1 - exp(-Pe_RLung)))
  q_RLungE' = Qf_RLung - Ql_RLung
  Alb_RLung' = Ja_RLung - Ql_RLung*Alb_RLung/V_RLungE
  // Muscle
  C_MuscleE = 3422/32.4384; Rcap_Muscle = 227.138; Rly_Muscle = 196.159; drive_Muscle = 0; m_Muscle = 29
  P_MuscleE := q_MuscleE/C_MuscleE
  V_MuscleE := q_MuscleE + 2439.02
  TPe_Muscle := 1.6*100*Alb_Muscle/V_MuscleE
  copE_Muscle := 2.1*TPe_Muscle + 0.16*TPe_Muscle^2 + 0.009*TPe_Muscle^3
  Qf_Muscle := (P_Muscle - copV - (P_MuscleE - copE_Muscle))/(Rcap_Muscle*TIeff)
  Ql_Muscle := max(0, P_MuscleE + drive_Muscle - P_Lymph)/Rly_Muscle
  Pe_Muscle := max(1e-9, Qf_Muscle*(1 - sigAlb)/(Dalb*m_Muscle))
  Ja_Muscle := max(0, Qf_Muscle*(1 - sigAlb)*(Alb_v/Vblood - Alb_Muscle/V_MuscleE*exp(-Pe_Muscle))/(1 - exp(-Pe_Muscle)))
  q_MuscleE' = Qf_Muscle - Ql_Muscle
  Alb_Muscle' = Ja_Muscle - Ql_Muscle*Alb_Muscle/V_MuscleE
  // Myocard
  C_MyocardE = 105.6/32.4386; Rcap_Myocard = 7360.47; Rly_Myocard = 6356.88; drive_Myocard = 0; m_Myocard = 0.33
  P_MyocardE := q_MyocardE/C_MyocardE
  V_MyocardE := q_MyocardE + 75.2655
  TPe_Myocard := 1.6*100*Alb_Myocard/V_MyocardE
  copE_Myocard := 2.1*TPe_Myocard + 0.16*TPe_Myocard^2 + 0.009*TPe_Myocard^3
  Qf_Myocard := (P_Myocard - copV - (P_MyocardE - copE_Myocard))/(Rcap_Myocard*TIeff)
  Ql_Myocard := max(0, P_MyocardE + drive_Myocard - P_Lymph)/Rly_Myocard
  Pe_Myocard := max(1e-9, Qf_Myocard*(1 - sigAlb)/(Dalb*m_Myocard))
  Ja_Myocard := max(0, Qf_Myocard*(1 - sigAlb)*(Alb_v/Vblood - Alb_Myocard/V_MyocardE*exp(-Pe_Myocard))/(1 - exp(-Pe_Myocard)))
  q_MyocardE' = Qf_Myocard - Ql_Myocard
  Alb_Myocard' = Ja_Myocard - Ql_Myocard*Alb_Myocard/V_MyocardE
  // Skin
  C_SkinE = 1260.6/9.10241; Rcap_Skin = 616.584; Rly_Skin = 123.317; drive_Skin = 20.0179; m_Skin = 3.3
  P_SkinE := q_SkinE/C_SkinE
  V_SkinE := q_SkinE + 3201.95
  TPe_Skin := 1.6*100*Alb_Skin/V_SkinE
  copE_Skin := 2.1*TPe_Skin + 0.16*TPe_Skin^2 + 0.009*TPe_Skin^3
  Qf_Skin := (P_Skin - copV - (P_SkinE - copE_Skin))/(Rcap_Skin*TIeff)
  Ql_Skin := max(0, P_SkinE + drive_Skin - P_Lymph)/Rly_Skin
  Pe_Skin := max(1e-9, Qf_Skin*(1 - sigAlb)/(Dalb*m_Skin))
  Ja_Skin := max(0, Qf_Skin*(1 - sigAlb)*(Alb_v/Vblood - Alb_Skin/V_SkinE*exp(-Pe_Skin))/(1 - exp(-Pe_Skin)))
  q_SkinE' = Qf_Skin - Ql_Skin
  Alb_Skin' = Ja_Skin - Ql_Skin*Alb_Skin/V_SkinE
  // Spleen
  C_SpleenE = 31.05/32.4471; Rcap_Spleen = 25032.7; Rly_Spleen = 21662.4; drive_Spleen = 0; m_Spleen = 0.15
  P_SpleenE := q_SpleenE/C_SpleenE
  V_SpleenE := q_SpleenE + 22.1248
  TPe_Spleen := 1.6*100*Alb_Spleen/V_SpleenE
  copE_Spleen := 2.1*TPe_Spleen + 0.16*TPe_Spleen^2 + 0.009*TPe_Spleen^3
  Qf_Spleen := (P_Spleen - copV - (P_SpleenE - copE_Spleen))/(Rcap_Spleen*TIeff)
  Ql_Spleen := max(0, P_SpleenE + drive_Spleen - P_Lymph)/Rly_Spleen
  Pe_Spleen := max(1e-9, Qf_Spleen*(1 - sigAlb)/(Dalb*m_Spleen))
  Ja_Spleen := max(0, Qf_Spleen*(1 - sigAlb)*(Alb_v/Vblood - Alb_Spleen/V_SpleenE*exp(-Pe_Spleen))/(1 - exp(-Pe_Spleen)))
  q_SpleenE' = Qf_Spleen - Ql_Spleen
  Alb_Spleen' = Ja_Spleen - Ql_Spleen*Alb_Spleen/V_SpleenE

  // ------------------------------------------------------------------
  // Charge balances (d(C*P)/dt = net inflow)
  // ------------------------------------------------------------------
  q_Ao' = Q_aov - (Qa_Brain + Qa_Bone + Qa_Fat + Qa_LArm + Qa_RArm + Qa_LKidney + Qa_RKidney + Qa_LLeg + Qa_RLeg + Qa_Muscle + Qa_Myocard + Qa_Skin + Qa_Spleen + Qa_Gut + Qa_Liver)
  q_Brain' = Qa_Brain - Qv_Brain - Qf_Brain
  q_Bone' = Qa_Bone - Qv_Bone - Qf_Bone
  q_Fat' = Qa_Fat - Qv_Fat - Qf_Fat
  q_LArm' = Qa_LArm - Qv_LArm
  q_RArm' = Qa_RArm - Qv_RArm
  q_LKidney' = Qa_LKidney - Qv_LKidney - Qf_LKidney
  q_RKidney' = Qa_RKidney - Qv_RKidney - Qf_RKidney
  q_LLeg' = Qa_LLeg - Qv_LLeg
  q_RLeg' = Qa_RLeg - Qv_RLeg
  q_Muscle' = Qa_Muscle - Qv_Muscle - Qf_Muscle
  q_Myocard' = Qa_Myocard - Qv_Myocard - Qf_Myocard
  q_Skin' = Qa_Skin - Qv_Skin - Qf_Skin
  q_Spleen' = Qa_Spleen - Qv_Spleen - Qf_Spleen
  q_Gut' = Qa_Gut - Qv_Gut - Qf_Gut
  q_Liver' = Qa_Liver + Q_portal - Qv_Liver - Qf_Liver
  q_VC' = Qv_Brain + Qv_Bone + Qv_Fat + Qv_LArm + Qv_RArm + Qv_LKidney + Qv_RKidney + Qv_LLeg + Qv_RLeg + Qv_Muscle + Qv_Myocard + Qv_Skin + Qv_Liver + Q_LymphVC + Q_IV - Q_rh
  q_RA' = Q_rh - Q_tri
  q_RV' = Q_tri - Q_RPA - Q_LPA
  q_RPA' = Q_RPA - Q_RPCap - Q_RShunt
  q_RPC' = Q_RPCap - Q_RPVein - Qf_RLung
  q_LPA' = Q_LPA - Q_LPCap - Q_LShunt
  q_LPC' = Q_LPCap - Q_LPVein - Qf_LLung
  q_LA' = Q_RPVein + Q_LPVein + Q_RShunt + Q_LShunt - Q_mit
  q_LV' = Q_mit - Q_aov
  q_Lymph' = Ql_Fat + Ql_Bone + Ql_Brain + Ql_Gut + Ql_LKidney + Ql_RKidney + Ql_Liver + Ql_LLung + Ql_RLung + Ql_Muscle + Ql_Myocard + Ql_Skin + Ql_Spleen - Q_LymphVC
  // plasma albumin, single well-mixed pool; lymph carries albumin back
  Alb_Ly := Alb_lymph
  Alb_lymph' = Ql_Fat*Alb_Fat/V_FatE + Ql_Bone*Alb_Bone/V_BoneE + Ql_Brain*Alb_Brain/V_BrainE + Ql_Gut*Alb_Gut/V_GutE + Ql_LKidney*Alb_LKidney/V_LKidneyE + Ql_RKidney*Alb_RKidney/V_RKidneyE + Ql_Liver*Alb_Liver/V_LiverE + Ql_LLung*Alb_LLung/V_LLungE + Ql_RLung*Alb_RLung/V_RLungE + Ql_Muscle*Alb_Muscle/V_MuscleE + Ql_Myocard*Alb_Myocard/V_MyocardE + Ql_Skin*Alb_Skin/V_SkinE + Ql_Spleen*Alb_Spleen/V_SpleenE - Q_LymphVC*Alb_lymph/(q_Lymph + 1600)
  Alb_v' = Q_LymphVC*Alb_lymph/(q_Lymph + 1600) + Q_IV*IValb - (Ja_Fat + Ja_Bone + Ja_Brain + Ja_Gut + Ja_LKidney + Ja_RKidney + Ja_Liver + Ja_LLung + Ja_RLung + Ja_Muscle + Ja_Myocard + Ja_Skin + Ja_Spleen)
  Vblood := q_Ao + U_Ao + q_Brain + U_Brain + q_Bone + U_Bone + q_Fat + U_Fat + q_LArm + U_LArm + q_RArm + U_RArm + q_LKidney + U_LKidney + q_RKidney + U_RKidney + q_LLeg + U_LLeg + q_RLeg + U_RLeg + q_Muscle + U_Muscle + q_Myocard + U_Myocard + q_Skin + U_Skin + q_Spleen + U_Spleen + q_Gut + U_Gut + q_Liver + U_Liver + q_VC + U_VC + q_RA + U_RA + q_RPA + U_RPA + q_RPC + U_RPC + q_LPA + U_LPA + q_LPC + U_LPC + q_LA + U_LA + q_LV + U_LV + q_RV + U_RV
  Vextra := V_FatE + V_BoneE + V_BrainE + V_GutE + V_LKidneyE + V_RKidneyE + V_LiverE + V_LLungE + V_RLungE + V_MuscleE + V_MyocardE + V_SkinE + V_SpleenE
  albumin_gdL := 100*Alb_v/Vblood
  Q_IV = 0; IValb = 0      // IV fluid (mL/s) and its albumin (g/mL); 0 = saline

  // ------------------------------------------------------------------
  // Baroreflex (Nervous.cpp; Ursino 2000 with Voigt-body baroreceptors)
  // Chemoreceptor and lung-stretch afferents are held at baseline.
  // ------------------------------------------------------------------
  fbOn = 1                  // 0 = open loop (used for stabilisation)
  Pop = 114; Ppl = -3.7     // baroreceptor operating point; mean pleural pressure
  fAC = 3.55; fAP = 12.0    // chemoreceptor and lung-stretch afferents (constant)
  wallC := 1 - sqrt((1 + exp(-0.04*(SBP - Pop)))/(5 + exp(-0.04*(SBP - Pop))))
  wallA := 1 - sqrt((1 + exp(-0.04*(SBP - Ppl - Pop)))/(5 + exp(-0.04*(SBP - Ppl - Pop))))
  epsC' = (0.1*wallC - epsC)/0.9
  epsA' = (0.1*wallA - epsA)/0.9
  bss = 0.9*(1 - sqrt(0.333333333333333))
  fABC := (2.52 + 47.78*exp((wallC - epsC - bss)/0.075))/(1 + exp((wallC - epsC - bss)/0.075))
  fABA := (2.52 + 47.78*exp((wallA - epsA - bss)/0.075))/(1 + exp((wallA - epsA - bss)/0.075))
  xCP' = ((CVP - Ppl) - xCP)/6
  xCP0 = 2.5
  fACP := 20/(1 + exp((xCP0 - xCP)/3.429))
  fSSA := 2.1 + (16.11 - 2.1)*exp(0.0675*(-0.4*fABC - 0.6*fABA + 1.0*fAC - 1.38*(fACP - 10) - 3.85))
  fSP := 2.1 + (16.11 - 2.1)*exp(0.0675*(-0.678*fABC - 0.452*fABA + 1.716*fAC - 0.34*fAP - 1.38*(fACP - 10) - 1.9))
  fVag := max(0, 0.5*(1.2 + 6.3*exp((fABC - 25.15)/7.06))/(1 + exp((fABC - 25.15)/7.06)) + 0.5*(1.2 + 6.3*exp((fABA - 25.15)/7.06))/(1 + exp((fABA - 25.15)/7.06)) + 0.15*fAC + 0.0745*fAP + 0.648)
  // baseline signals (set at the healthy steady state)
  fSP0 = 4.05; fSSA0 = 4.5; fVag0 = 3.75
  lnSA := piecewise(ln(fSSA - 2.66 + 1), fSSA > 2.66, 0)
  lnSP := piecewise(ln(fSP - 2.66 + 1), fSP > 2.66, 0)
  gHRs = -0.13/0.58; gHRv = 0.09/0.58; gE = 0.475/2.392
  gRe = 1.94/1.655; gRm = 2.47/2.106; gRs = 0.695/2.49; gV = -0.116
  mHRs' = (gHRs*lnSA - mHRs)/2
  mHRv' = (gHRv*fVag - mHRv)/1.5
  mE' = (gE*lnSA - mE)/8
  mRe' = (gRe*lnSP/(1 + fatigue) - mRe)/6
  mRm' = (gRm*lnSP/(1 + fatigue) - mRm)/6
  mRs' = (gRs*lnSP/(1 + fatigue) - mRs)/6
  mC' = (gV*lnSP - mC)/20
  ln0SA := ln(fSSA0 - 2.66 + 1); ln0SP := ln(fSP0 - 2.66 + 1)
  hrScale := piecewise((1 + gHRs*ln0SA + gHRv*fVag0)/(1 + mHRs + mHRv), fbOn > 0.5, 1)
  eScale := piecewise((mE + 1)/(gE*ln0SA + 1), fbOn > 0.5, 1)
  rsExt := piecewise((mRe + 1)/(gRe*ln0SP + 1), fbOn > 0.5, 1)
  rsMus := piecewise((mRm + 1)/(gRm*ln0SP + 1), fbOn > 0.5, 1)
  rsSpl := piecewise((mRs + 1)/(gRs*ln0SP + 1), fbOn > 0.5, 1)
  cScale := piecewise((mC + 1)/(gV*ln0SP + 1), fbOn > 0.5, 1)
  // sympathetic peripheral fatigue during infection (time constant 2 h)
  fatigue' = infOn*piecewise((fSP - 6)/7200, fSP > 6, -fatigue/(100*3600), fSP < 5.9, 0)

  // ------------------------------------------------------------------
  // Acute Inflammatory Response (BloodChemistry::InflammatoryResponse)
  // Rates in BioGears are per hour: k = infOn*infScale/3600 converts.
  // ------------------------------------------------------------------
  infOn = 0                 // set to 1 to start an infection (see events)
  infScale = 1              // time acceleration of inflammation, as BioGears 'scale'
  kh := infOn*infScale/3600
  antibiotic = 0            // antibacterial effect on blood pathogen growth (1/h)
  // tissue (Dominguez-Huttinger 2017)
  thetaP = 1.35e-4; epsPB = 3.1; psiPM = 6.3e-3; psiPN = 6.1e-4; kapP = 0.6; uP = 3.7e4
  Mv = 0.3; delM = 6.4e-5; epsMB = 36; beta = 2.6e-2
  Nv = 1e8; delN = 6.1e-2; epsNB = 36; epsNM = 0.16; alphaN = 6.975e-7
  kapB = 4.6e-2; epsBP = 26; psiBP = 0.14; psiBN = 4.0e-8
  pUpper = 2.0e6; pLower = 1.0e3
  // blood (Chow 2005)
  sM = 1; sN = 1; s6 = 0.001; s10 = 0.01
  kPN = 5.8; xPN = 0.5; kPS = 6.9e3; xPS = 1.3e4
  kML = 101; kMTR = 0.04; kM6 = 0.1; kMR = 0.05; kMD = 0.05; xML = 37.5; xMD = 0.75; xMTNF = 0.4; xM6 = 1.0; xM10 = 0.297
  kMA = 0.2
  kNL = 33.75; kNTNF = 0.4; kN6 = 1.5; kND = 0.05; kNTR = 0.02; kNR = 0.05; kNA = 0.5; xNL = 56.25; xNTNF = 2.0; xN6 = 1.0; xND = 0.4; xN10 = 0.2
  kINOSN = 1.5; kINOSM = 0.1; kINOSEC = 0.1; kINOS6 = 2.0; kINOSd = 0.05; kINOS = 0.101; xINOS10 = 0.1; xINOSTNF = 0.05; xINOS6 = 0.1; xINOSNO = 0.3
  kENOS = 4.0; kENOSEC = 0.05; xENOSTNF = 0.4; xENOSL = 1.015; xENOSTR = 0.1
  kNO3 = 0.46; kNOMA = 2.0
  kTNFN = 2.97; kTNFM = 0.1; kTNF = 1.4; xTNF6 = 0.059; xTNF10 = 0.079
  k6M = 3.03; k6TNF = 1.0; k6NO = 2.97; k6 = 0.7; k6N = 0.2; x610 = 0.1782; x6TNF = 0.1; x66 = 0.5; x6NO = 0.4; h66 = 1.0
  k10MA = 0.1; k10N = 0.1; k10TNF = 1.485; k106 = 0.051; k10 = 0.35; k10R = 0.1; x10TNF = 0.05; x1012 = 0.01; x106 = 0.08
  k12M = 0.303; k12 = 0.05; x1210 = 0.2525
  kD6 = 0.125; kD = 0.15; xD6 = 0.85; xDNO = 0.5; hD6 = 6.0; tiMin = 0.2
  kTr = 0; kDTR = 0; kCA = 0.1; kCATR = 0.16

  // TLR switch with hysteresis
  TLR = 0
  E_tlrOn: at (PT > pUpper): TLR = 1
  E_tlrOff: at (PT < pLower): TLR = 0

  actM := (kML*hillA(PB, xML, 2) + kMD*hillA(1 - TI, xMD, 4))*(hillA(TNF, xMTNF, 2) + kM6*hillA(I6, xM6, 2)) + kMTR*TR
  actN := kNL*hillA(PB, xNL, 2) + kNTNF*xNTNF*hillA(TNF, xNTNF, 1) + kN6*xN6^2*hillA(I6, xN6, 2) + kND*xND^2*hillA(1 - TI, xND, 2) + kNTR*TR
  // as written in BioGears: logistic term uses (1 - PT), not (1 - PT/uP)
  PT' = kh*((kapP/uP)*PT*(1 - PT) - thetaP*PT/(1 + epsPB*B) - psiPN*NT*PT - psiPM*MT*PT)
  MT' = kh*(beta*NT/(1 + epsMB*B)*Mv - delM*MT)
  NT' = kh*(alphaN*TLR*Nv/((1 + epsNB*B)*(1 + epsNM*MT)) - delN*NT)
  B' = kh*(kapB/(1 + epsBP*TLR)*B*(1 - B) - psiBP*TLR*B - psiBN*NT*B)
  PB' = kh*((kapP - antibiotic)*PB + thetaP*PT/(1 + epsPB*B) - kPS*PB/(xPS + PB) - kPN*NA*hillA(PB, xPN, 2))
  TR' = kh*(-kTr*TR)
  MR' = kh*(-actM*MR*hillI(I10, xM10, 2) - kMR*(MR - sM))
  MA' = kh*(actM*MR*hillI(I10, xM10, 2) - kMA*MA)
  NR' = kh*(-actN*hillI(I10, xN10, 2)*NR - kNR*(NR - sN))
  NA' = kh*(actN*hillI(I10, xN10, 2)*NR - kNA*NA)
  iNOS' = kh*(kINOS*(iNOSd - iNOS))
  iNOSd' = kh*((kINOSN*NA + kINOSM*MA + kINOSEC*(xINOSTNF^2*hillA(TNF, xINOSTNF, 2) + kINOS6*xINOS6^2*hillA(I6, xINOS6, 2)))*hillI(I10, xINOS10, 2)*hillI(NO, xINOSNO, 4) - kINOSd*iNOSd)
  eNOS' = kh*(kENOSEC*hillI(TNF, xENOSTNF, 1)*hillI(PB, xENOSL, 1)*hillI(TR, xENOSTR, 4) - kENOS*eNOS)
  NO3' = kh*(kNO3*(NO - NO3))
  TNF' = kh*((kTNFN*NA + kTNFM*MA)*hillI(I10, xTNF10, 2)*hillI(I6, xTNF6, 3) - kTNF*TNF)
  I6' = kh*((k6N*NA + MA)*(k6M + k6TNF*hillA(TNF, x6TNF, 2) + k6NO*hillA(NO, x6NO, 2))*hillI(I10, x610, 2)*hillI(I6, x66, h66) + k6*(s6 - I6))
  I10' = kh*((k10N*NA + MA)*(k10MA + k10TNF*hillA(TNF, x10TNF, 4) + k106*hillA(I6, x106, 4))*((1 - k10R)*hillI(I12, x1012, 4) + k10R) - k10*(I10 - s10))
  I12' = kh*(k12M*MA*hillI(I10, x1210, 2) - k12*I12)
  CA' = kh*(-kCA*CA)
  TI' = kh*(kD*(1 - TI)*(TI - tiMin)*TI - (TI - tiMin)*(kD6*hillA(I6, xD6, hD6) + kDTR*TR)*(1/(xDNO^2 + NO^2)))
  NO := iNOS*(1 + kNOMA*(MA + NA)) + eNOS
  TIeff := piecewise(TI, infOn > 0.5, 1)
  WBC := 7000*(1 + NA/0.25)      // white cell count, cells/uL (BioGears ManageSIRS)

  // infection actions: set infOn = 1 and seed tissue pathogen
  infectionStart = 1e12; severity = 0   // severity 1 mild, 2 moderate, 3 severe
  E_infect: at (time >= infectionStart), t0 = false: infOn = 1, TLR = 1, PT = piecewise(1e6, severity < 1.5, 5e6, severity < 2.5, 2.5e7)

  // ------------------------------------------------------------------
  // Outputs
  // ------------------------------------------------------------------
  SVR := (MAP - CVP)/(COmeas*1000/60)

  // ------------------------------------------------------------------
  // Initial state: BioGears setup targets (replaced by the stabilised state)
  // ------------------------------------------------------------------
  q_Ao = C_Ao0*114
  q_Brain = C_Brain0*9.12
  q_Bone = C_Bone0*37.62
  q_Fat = C_Fat0*37.62
  q_LArm = C_LArm0*37.62
