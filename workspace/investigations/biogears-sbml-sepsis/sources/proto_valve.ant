  E_tlrOn: at PT > pUpper: TLR = 1;
  E_tlrOff: at PT < pLower: TLR = 0;
  E_infect: at time >= infectionStart, t0=false: infOn = 1, TLR = 1, PT = piecewise(1000000, severity < 1.5, 5000000, severity < 2.5, 25000000);

