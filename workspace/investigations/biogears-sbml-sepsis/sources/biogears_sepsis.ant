  q_LLeg = 71.3614103; q_LLungE = -124.6583033; q_LPA = 90.82486842; q_LPC = 76.56186022; q_LV = 129.6280231; q_Liver = 505.4833143
  q_LiverE = 19.26112858; q_Lymph = 2050.341555; q_Muscle = 661.1240209; q_MuscleE = 960.8492142; q_Myocard = 33.04158755; q_MyocardE = 28.17688874
